# Shopify Konfiguration
SHOPIFY_STORE_URL=estid-fashion.myshopify.com
SHOPIFY_ACCESS_TOKEN=dein-shopify-access-token
SHOPIFY_API_VERSION=2024-01

# Google Merchant Center
GOOGLE_MERCHANT_ID=deine-merchant-id
GOOGLE_CLIENT_ID=deine-google-client-id
GOOGLE_CLIENT_SECRET=dein-google-client-secret
GOOGLE_REFRESH_TOKEN=dein-google-refresh-token

# App Konfiguration
PORT=3000
SHOP_DOMAIN=https://www.estid-fashion.de
FEED_LANGUAGE=de
FEED_CURRENCY=EUR
FEED_COUNTRY=DE
